      "definition": "Does the gold concept EXIST in the 240-node corpus, by DIRECT corpus check? E=standalone component/rule (or naming variant); B=embedded/borderline only; A=absent. Independent of any retrieval method (m-0364c120: a miss is not a content gap).",
      "pooled_number_warning": "The pooled coverage mixes mainstream selection (PA/PB/TK/SEED) with deliberately-probed canon-edge cases (CE). Read the by_qclass split, not the pool (m-e8ccb163).",
      "tally": {
        "A_absent": 2,
        "B_borderline": 0,
        "E_exists": 58
      },
      "total_golds": 60
    },
    "matcher_reachable_ceiling_method_dependent": {
      "composite": {
        "benchmark_E_golds_composite_reachable": 58,
        "benchmark_E_golds_total": 58,
        "composite_reachable_ceiling": 1.0,
        "reading": "The composite wiring ceiling is high (content + wiring both present), yet recall@10 on the BLIND problem-language queries is low -- the gap is a REACHABILITY gap (register mismatch: prose queries do not trigger the exact-substring rule leg nor the exact-token spec_component leg), NOT a content gap. Answered by measurement, not assumed (m-0364c120)."
      },
      "definition": "Ceiling on what the CURRENT four-surface matcher could ever retrieve, by corpus WIRING (query-independent). Split per leg because each leg caps a different register.",
      "leg1_match_structural_signals": {
        "benchmark_E_golds_leg1_reachable": 53,
        "corpus_component_count": 66,
        "corpus_components_rule_wired": 47,
        "corpus_rule_refs_dangling_note": "216 of 263 distinct rec/alt refs dangle (193 present nowhere in the 240-node corpus) -- the m-0364c120 reachability defect in a content-gap costume.",
        "corpus_rule_refs_total": 362,
        "definition": "A component is rule-reachable iff some rule names it as a REAL recommended_pattern or alternative. Dangling refs resolve to husk stubs (loader.py:197), NOT the real component, and do not count. This caps the PA/PB (rule-prose) register."
      },
      "leg3_spec_component": {
        "benchmark_E_golds_leg3_reachable": 50,
        "definition": "Every real component id is resolvable by spec_component via its own exact-id token (hyphen/underscore normalised), so the corpus ceiling over component golds is total -- but ONLY a token query triggers it (the TK/SEED register). Archetype-only aliases whose id is not a real component (input, navigation) resolve to a HUSK, not the real id."
      }
    },
    "note": "THREE denominators, kept strictly distinct (m-0364c120). Never conflated.",
    "reachable_set_for_recall": {
      "FROZEN_reachable_denominator": 58,
      "definition": "recall denominator = E-golds only (B and A excluded, scored neutral)."
    }
  },
  "3_score": {
    "answer_key_definition": "sha256 over sorted (problem_id, canonical, sorted(acceptable_ids)) tuples of every E-gold. Pinned in the freeze manifest; grade re-compares it so an acceptable_ids widening trips drift even when the graded result is unchanged (closes the mnemos B4 seam at S0).",
    "answer_key_sha256": "ee32b73cc1867ea1570f2fb77fa0bf90fa19d9127fb1ac5bd4c40b57d7088f72",
    "formula": "recall@k = (# E-golds whose acceptable_ids intersect the method's top-k) / E-golds",
    "method_output_contract": "Per problem the method emits a rank-ordered list of DISTINCT corpus ids. BASELINE = grade.rank_baseline (the four-surface UNION). AFTER = the ported retrieval engine over the SAME frozen queries + corpus.",
    "metric": "concept_recall_at_k",
    "primary_cutoff_k": 10,
    "secondary_cutoff_k": 5
  },
  "4_stratification": {
    "dimensions": {
      "qclass": {
        "CE": "canon-edge content-coverage probe",
        "PA": "prose, rule-prose-aligned (matcher answerable)",
        "PB": "prose, problem-language / blind (matcher misses)",
        "SEED": "token, known component_type -> rich KB spec vs archetype/skeleton husk",
        "TK": "token, component-id vocabulary (spec_component seed path)"
      },
      "register": [
        "prose",
        "token"
      ],
      "structure": "component category of each E-gold's acceptable ids (or decision_rule)"
    },
    "rule": "m-e8ccb163: never a single pooled mean. The finest split (qclass) is primary."
  },
